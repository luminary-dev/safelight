# Safelight environment reference.
# Copy to .env for docker compose, or export in your shell for native runs.
# Every variable below is actually read by web/src — nothing speculative.

# ---------------------------------------------------------------------------
# Core Safelight settings (SAFELIGHT_*)
# ---------------------------------------------------------------------------

# Root directory for all mutable state: SQLite DB, encrypted key vault,
# library index. Default (native): <repo>/data. In Docker: /data (volume).
#SAFELIGHT_DATA_DIR=/data

# Extra hostnames the API middleware accepts, comma-separated.
# localhost / 127.0.0.1 / [::1] are always allowed. Required for LAN access,
# otherwise every /api request from another machine gets a 403.
#SAFELIGHT_ALLOWED_HOSTS=192.168.1.10,safelight.lan

# Extra directories Code mode's /api/code/browse may list, comma-separated
# absolute paths. Keep this tight; it is a filesystem-exposure surface.
#SAFELIGHT_BROWSE_ROOTS=/home/me/projects

# 64 hex chars (32 bytes) used as the AES-256-GCM vault key for provider API
# keys. If unset: macOS Keychain, else a generated /data/.vault-key file
# (mode 600). Set it explicitly on servers so the vault survives volume moves.
# Generate: openssl rand -hex 32
#SAFELIGHT_VAULT_KEY=

# Override the encrypted key-store path (default: $SAFELIGHT_DATA_DIR/keys.enc.json).
#SAFELIGHT_KEYS_FILE=

# Override the legacy JSON sessions file path (default: $SAFELIGHT_DATA_DIR/sessions.json).
#SAFELIGHT_SESSIONS_FILE=

# Per-provider base-URL overrides for gateways (Azure OpenAI, vLLM, LiteLLM…).
# Pattern: SAFELIGHT_<PROVIDER>_BASE_URL, provider one of:
# OPENAI, ANTHROPIC, GEMINI, OPENROUTER, GROQ, MISTRAL, DEEPSEEK, XAI, TOGETHER
#SAFELIGHT_OPENAI_BASE_URL=

# (SAFELIGHT_TEST_SECRET exists only inside the test suite — never set it.)

# ---------------------------------------------------------------------------
# ComfyUI wiring
# ---------------------------------------------------------------------------

# Server-side URL the Next.js server uses to reach ComfyUI.
# Native default: http://127.0.0.1:8188. Compose sets http://comfyui:8188.
#COMFY_URL=http://127.0.0.1:8188

# BUILD-TIME (NEXT_PUBLIC_*): the WebSocket URL the BROWSER connects to for
# render progress. Inlined into the client bundle — changing it requires a
# rebuild (docker compose build web). For LAN use, point it at the ComfyUI
# port as reachable from the browser, e.g. ws://192.168.1.10:8188.
#NEXT_PUBLIC_COMFY_WS=ws://127.0.0.1:8188

# Where rendered images land / uploads are read from.
# Native defaults: <repo>/outputs and <repo>/inputs. Docker: /outputs, /inputs.
#COMFY_OUTPUT_DIR=
#COMFY_INPUT_DIR=

# Path to ComfyUI's extra_model_paths.yaml for the model manager.
# Default: <repo>/comfyui/extra_model_paths.yaml.
#COMFY_EXTRA_MODEL_PATHS=

# Directory of ComfyUI workflow blueprints.
# Default: <repo>/comfyui/blueprints.
#BLUEPRINTS_DIR=

# ---------------------------------------------------------------------------
# Ollama
# ---------------------------------------------------------------------------

# Server-side URL for local chat models.
# Native default: http://127.0.0.1:11434. Compose sets http://ollama:11434.
#OLLAMA_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Provider API keys (optional — the in-app vault is preferred; these env
# vars are fallbacks read when the vault has no entry for the provider)
# ---------------------------------------------------------------------------
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
#XAI_API_KEY=
#TOGETHER_API_KEY=

# Search / model-hub tokens
#BRAVE_SEARCH_API_KEY=
#TAVILY_API_KEY=
#HF_TOKEN=
#CIVITAI_API_TOKEN=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# pino log level (default: info)
#LOG_LEVEL=info

# Legacy (pre-rename) fallbacks, still honoured for migration only:
#STUDIO_KEYS_FILE=
#STUDIO_SESSIONS_FILE=
