{
  "//": "Apply once luminary-dev is on GitHub Team (branch protection is paywalled for private repos on the free org plan): gh api repos/luminary-dev/safelight/rulesets -X POST --input .github/rulesets/main-protection.json  — bypass_actors keeps the solo direct-push workflow working for repo admins; remove it for strict PR-only.",
  "name": "main protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/main"], "exclude": [] } },
  "bypass_actors": [{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "pull_request", "parameters": { "required_approving_review_count": 0, "dismiss_stale_reviews_on_push": true, "require_code_owner_review": false, "require_last_push_approval": false, "required_review_thread_resolution": true } },
    { "type": "required_status_checks", "parameters": { "strict_required_status_checks_policy": true, "required_status_checks": [ { "context": "verify" }, { "context": "e2e" }, { "context": "semgrep" } ] } }
  ]
}
