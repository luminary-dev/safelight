#!/bin/sh
# Repo rule (RELEASING.md): never force-push, never delete main or a v* tag.
# GitHub-side rulesets need a paid plan for private repos, so this guards locally.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/tags/v*)
      if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        echo "pre-push: refusing to delete $remote_ref" >&2; exit 1
      fi
      if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && \
         ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing non-fast-forward push to $remote_ref (repo forbids force-push)" >&2; exit 1
      fi
      ;;
  esac
done
exit 0
